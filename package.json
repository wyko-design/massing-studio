{
  "name": "massing-studio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w @massing/server\" \"npm run dev -w @massing/client\"",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @massing/client",
    "clean": "rimraf client/dist coverage"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "concurrently": "^10.0.5",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
