# Copy to .env and fill in. .env is git-ignored. Never commit secrets.
# All variables are server-side only. Never prefix them with VITE_.

# In-app LLM calls (M4) go through the Claude Agent SDK, which uses this machine's Claude login
# (~/.claude/.credentials.json: log in to Claude Code once on each machine). Personal/local use only.
# Optional: an Anthropic API key here takes precedence over the login. Leave empty to use the login.
ANTHROPIC_API_KEY=
# Model for in-app LLM calls.
LLM_MODEL=claude-sonnet-5-5

# Port of the Node server (bound to 127.0.0.1). Vite proxies /api here.
SERVER_PORT=8787
# Port of the Vite dev client (optional, default 5173). Lets a second dev server run beside the first.
# PORT=5173
# Active site: data/sites/<SITE_ID>.json and cache dir data/cache/<SITE_ID>/.
SITE_ID=placeholder
# readwrite = serve from cache, fetch + store on miss.
# offline   = cache only, fail on miss (demo rehearsal, SPEC §15 step 4).
CACHE_MODE=readwrite
# Address loaded by default; its responses are cached under data/cache/<SITE_ID>/.
# Other addresses typed in the UI are cached in data/cache/_adhoc/ (git-ignored).
SITE_ADDRESS=Hendrik Casimirstraat 8, Delft

# --- Hosted deployment (see DEPLOY.md) ---
# Bind address. 0.0.0.0 on a host, 127.0.0.1 locally.
# HOST=0.0.0.0
# Shared password for the whole site (browser asks once; user name is "massing"). Set it when hosted.
# ACCESS_PASSWORD=
# Max AI calls per hour across all users, to cap API spend.
# AI_HOURLY_LIMIT=60

# Use Gemini instead of Claude (free tier key from https://aistudio.google.com/apikey).
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# LLM_MODEL=gemini-3.8-flash
